{
  "name": "rewaq-store",
  "version": "1.1.1",
  "description": "سكربت متجر رواق — منصة تجارة إلكترونية متكاملة واحترافية باللغة العربية مع دعم الدفع الإلكتروني (الذهبية و CIB) والدفع عند الاستلام لـ 58 ولاية.",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "build:css": "node scripts/build-css.js",
    "build:js": "node scripts/build-js.js",
    "build:sw": "node scripts/build-sw-hash.js",
    "build": "npm run build:css && npm run build:js && node scripts/build-sw-hash.js && node scripts/validate.js",
    "lint": "eslint server.js src/ database/ test/ scripts/ js/ admin/js/",
    "dev:node": "node server.js",
    "migrate": "node database/migrate.js",
    "db:reset": "node database/reset.js",
    "create-admin": "node src/scripts/create-admin.js",
    "seed:demo": "node scripts/seedDemoData.js",
    "check:i18n": "node scripts/check-i18n.js",
    "check:responsive": "node scripts/responsive-check.js",
    "check:headers": "node scripts/check-headers.js",
    "test": "node test/all.test.js"
  },
  "keywords": [
    "ecommerce",
    "arabic",
    "store",
    "nodejs",
    "mysql"
  ],
  "author": "",
  "license": "UNLICENSED",
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "compression": "^1.8.2",
    "cors": "^2.8.5",
    "dotenv": "^17.4.2",
    "express": "^4.21.2",
    "express-rate-limit": "^6.11.2",
    "google-auth-library": "^11.3.1",
    "helmet": "^6.2.0",
    "jsonwebtoken": "^9.0.2",
    "multer": "^2.0.2",
    "mysql2": "^3.14.5",
    "sharp": "^0.35.5"
  },
  "devDependencies": {
    "eslint": "^10.9.0",
    "globals": "^17.11.0",
    "lightningcss": "^1.33.0",
    "playwright": "^1.64.0",
    "terser": "^5.51.2"
  }
}
